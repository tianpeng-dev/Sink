{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "s.tianpeng.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "NUXT_CF_ACCOUNT_ID": "77e355bb031ae797643a27a40d045b19",
    "NUXT_HOME_URL": "https://tianpeng.dev"
  },
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "404fc32b6be04eb89d54e65bcb101550",
      "id": "404fc32b6be04eb89d54e65bcb101550"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "preview_bucket_name": "sink-tianpeng",
      "bucket_name": "sink-tianpeng"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
